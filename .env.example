# Banco local (SQLite) para desenvolvimento: rode `npm run db:init` e deixe as
# variáveis do Supabase vazias. Mais detalhes no README.
# YELLO_LOCAL=1        força o banco local mesmo com o Supabase preenchido
# YELLO_LOCAL=0        força o Supabase e ignora o banco local
# YELLO_DB=            caminho do arquivo (padrão: .data/yello.db)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
